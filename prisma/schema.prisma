generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?  @unique   // now optional — set during profile completion, not registration
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  consumerProfile ConsumerProfile?
  providerProfile ProviderProfile?
}

model ConsumerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])

  realName       String   // private — never shown to providers
  campusLocation String
  department     String   // private, admin-only — for scammer tracking (agreed w/ co-founder)

  createdAt      DateTime @default(now())
}
enum Role {
  PROVIDER
  CONSUMER
}

enum AvailabilityStatus {
  ACTIVE
  BUSY
  INACTIVE
}

enum VerificationTier {
  STEP1
  STEP2
  STEP3
}

model ProviderProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id])

  legalName          String              // private, admin-visible only
  bio                String
  skillLevel         String
  campusLocation     String
  availabilityStatus AvailabilityStatus  @default(ACTIVE)
  phoneNumber        String
  whatsappNumber     String
  socialLinks        String[]            @default([])
  department         String
  profilePictureUrl  String

  verificationTier   VerificationTier    @default(STEP3)
  isVerified         Boolean             @default(false)

  createdAt          DateTime            @default(now())
}